# ─────────────────────────────────────────────────────────────────────────────
# Datheon AI Platform — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Authentication ────────────────────────────────────────────────────────────
# Comma-separated list of valid API keys for X-API-Key header auth.
# Rotate regularly. Minimum 32 characters recommended.
API_KEYS=dev-key-change-me,another-key-here

# ── Application ───────────────────────────────────────────────────────────────
APP_VERSION=1.0.0

# ── ChromaDB ─────────────────────────────────────────────────────────────────
# Path inside the container (mapped to a Docker volume in docker-compose.yml)
CHROMA_DB_PATH=/app/chroma_db

# ── Python runtime ────────────────────────────────────────────────────────────
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
